# Copy to ".env" (cp .env.example .env) and fill in your own secrets.

# Leave DASHBOARD_PASSWORD empty to disable login entirely.
DASHBOARD_PASSWORD=change-me-please

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-too

# How long an upload/placement session is kept before its files are deleted.
SESSION_TTL_HOURS=6
# Upload size cap (model + logo), in MB.
MAX_UPLOAD_MB=200
